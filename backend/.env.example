# Copy this file to .env and adjust values as needed.

PORT=3000

# Postgres connection string.
# Matches the docker-compose.yml defaults (see project root).
DATABASE_URL=postgres://asm:asm@localhost:5432/asm_duties

# Origin allowed to call this API from the browser (the frontend dev server).
ALLOWED_ORIGIN=http://localhost:5173

# One of: debug, info, warn, error
LOG_LEVEL=info
